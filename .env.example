# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# Tradovate credentials
# ---------------------------------------------------------------------------
# "demo" targets the simulation environment (virtual money, no real risk).
# "live" targets real funded accounts. Keep this on "demo" for the study.
TRADOVATE_ENV=demo

TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=STDVBOT
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
# Stable UUID identifying this machine. Generate once with:
#   python3 -c "import uuid; print(uuid.uuid4())"
TRADOVATE_DEVICE_ID=

# Optional: pin a specific account. Leave blank to auto-select the only
# active account, which fails loudly if more than one exists.
TRADOVATE_ACCOUNT_SPEC=

# ---------------------------------------------------------------------------
# Instrument and risk parameters (Setup steps 6-10)
# ---------------------------------------------------------------------------
STDVBOT_SYMBOL=MNQ
STDVBOT_RISK_PER_TRADE_PCT=1.0
STDVBOT_MAX_CONCURRENT_POSITIONS=1
STDVBOT_DAILY_LOSS_LIMIT_PCT=3.0
STDVBOT_CONFLUENCE_THRESHOLD=2
STDVBOT_STAGNANT_CUTOFF_MINUTES=30

STDVBOT_VWAP_TOLERANCE_TICKS=8
STDVBOT_ROUND_NUMBER_TOLERANCE_TICKS=4
STDVBOT_POI_TOLERANCE_TICKS=8

# ---------------------------------------------------------------------------
# Safety loop (Procedure steps 48-50)
# ---------------------------------------------------------------------------
STDVBOT_HEARTBEAT_INTERVAL_SECONDS=15
STDVBOT_FEED_STALE_SECONDS=90

# Experimental arm: regime_gated | permissive | random_control
STDVBOT_ARM=regime_gated
STDVBOT_RANDOM_SEED=1337
